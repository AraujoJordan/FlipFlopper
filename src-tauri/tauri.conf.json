{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlipFlopper",
  "version": "0.19.0",
  "identifier": "com.araujojordan.flipflopper",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlipFlopper",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true,
        "visible": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "MIT",
    "licenseFile": "LICENSE",
    "externalBin": [
      "binaries/flipflopper-node"
    ],
    "resources": {
      "agent-runtime/node_modules/": "agent-runtime/node_modules/",
      "agent-runtime/NODE-LICENSE": "agent-runtime/NODE-LICENSE"
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBQjc5REJDOUIwQjg0OTMKUldTVGhBdWJ2SjIzYWhNOHdzYS8vTzAvRDZoaDg1Tk5xWkF2NEhhOW9pK2NEOCtMSG1FdmZIL1AK",
      "endpoints": [
        "https://github.com/AraujoJordan/FlipFlopper/releases/latest/download/latest.json"
      ]
    }
  }
}
